# Machine-specific edrive configuration.
# Normally created automatically by: edrive setup
#
# All paths are absolute. This file belongs to one local installation.
# Never put passwords, private keys, age identities, or vault contents here.

EDRIVE_DATA_ROOT="/Users/you/edrive"
EDRIVE_GOOGLE_DRIVE_ROOT="/Users/you/edrive/google-drive-remote"
EDRIVE_GOOGLE_DRIVE_READY=false
EDRIVE_MOUNT="/Users/you/edrive/edrive"
EDRIVE_RECOVERY_DIR="/Users/you/edrive/recovery"
EDRIVE_RECIPIENTS="/Users/you/Library/Application Support/edrive/recipients.txt"
EDRIVE_MAC_IDENTITY="/Users/you/Library/Application Support/edrive/identities/mac.identity"
EDRIVE_RECOVERY_IDENTITY="/Users/you/edrive-recovery-identity.txt"
EDRIVE_SNAPSHOT_KEEP=20

EDRIVE_CRYPTOMATOR_VAULT="/Users/you/edrive/google-drive-remote/edrive"
EDRIVE_CRYPTOMATOR_VAULT_ID=""
EDRIVE_CRYPTOMATOR_CLI=""
EDRIVE_CRYPTOMATOR_MOUNTER="org.cryptomator.frontend.fuse.mount.FuseTMountProvider"
EDRIVE_CRYPTOMATOR_KEYCHAIN_SERVICE="Cryptomator"
EDRIVE_RUNTIME_DIR="/Users/you/Library/Application Support/edrive/runtime"
